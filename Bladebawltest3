repeat task.wait() until game:IsLoaded()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RS = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer
warn("[dist] pure distance test live - ParryAttempt at <= 4 studs, 0.5s cooldown")
local lastFire = 0
while true do
    task.wait()
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local balls = Workspace:FindFirstChild("Balls")
    if hrp and balls then
        for _, ball in ipairs(balls:GetChildren()) do
            if ball:GetAttribute("target") == lp.Name then
                local d = (ball.Position - hrp.Position).Magnitude
                if d <= 4 and tick() - lastFire > 0.5 then
                    lastFire = tick()
                    warn("[dist] FIRE at " .. string.format("%.2f", d) .. " studs")
                    pcall(function() RS.Remotes.ParryAttempt:FireServer() end)
                end
            end
        end
    end
end
