CFG.OnUnload = function()
    CFG.Alive = false
    for _, conn in ipairs(CFG.Connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    CFG.Connections = {}
end

task.spawn(function()
    while CFG.Alive do
        task.wait()
