    "Aiko", "Korg", "Minority Destroyer 8000", "Yvaine",
    "ankylodocus", "malusaurus", "peep", "seal", "wendigo thing",
}

local DINO_TEMPLATE = { Oxygen = 10, Health = 125, Thirst = 100, Energy = 175, Growth = 0, Hunger = 100 }

local function injectAllDinos()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(Saved.Value)
    end)
    if not ok or type(data) ~= "table" then return end
    data.Dinos = data.Dinos or {}
    for _, name in ipairs(DINO_NAMES) do
        if not data.Dinos[name] then
            data.Dinos[name] = DINO_TEMPLATE
        end
    end
    for _, name in ipairs(HIDDEN_DINOS) do
        if not data.Dinos[name] then
            data.Dinos[name] = DINO_TEMPLATE
        end
    end
    Saved.Value = HttpService:JSONEncode(data)
end

local function addHiddenDinoButtons()
    local gui = Players.LocalPlayer.PlayerGui:FindFirstChild("Menu")
    local list = gui and gui:FindFirstChild("PlayPage") and gui.PlayPage:FindFirstChild("DinoList")
    if not list then return end
    local template
    for _, b in ipairs(list:GetChildren()) do
        if b:IsA("ImageButton") then
            template = b
            break
        end
    end
    if not template then return end
    local existing = {}
    for _, b in ipairs(list:GetChildren()) do
        if b:IsA("ImageButton") then
            local t = b:FindFirstChild("Title")
            existing[t and t.Text or b.Name] = true
        end
    end
    local added = 0
    for _, name in ipairs(HIDDEN_DINOS) do
        if not existing[name] then
            local btn = template:Clone()
            btn.Name = name
            btn.LayoutOrder = 999 + added
            local title = btn:FindFirstChild("Title")
            if title then title.Text = name end
            btn.Visible = true
            btn.Parent = list
            table.insert(CFG.Connections, btn.MouseButton1Down:Connect(function()
                injectAllDinos()
                local info = gui.PlayPage.Background2 and gui.PlayPage.Background2.Info
                if info then
                    local dinoText = info:FindFirstChild("Dinosaur")
                    if dinoText then dinoText.Text = name end
                    local spawnBtn = info:FindFirstChild("Button")
                    if spawnBtn and spawnBtn:FindFirstChild("Title") then
                        spawnBtn.Title.Text = "Spawn"
                    end
                end
            end))
            added = added + 1
        end
    end
    if added > 0 then
        Library:Notify("Added " .. added .. " hidden dinos to menu")
    end
end

local function hookDataReplicator()
    local SendData = ReplicatedStorage.Events.UI:FindFirstChild("SendDataToClient")
    if SendData then
        table.insert(CFG.Connections, SendData.OnClientEvent:Connect(function()
            if CFG.UnlockAllActive then
                task.wait(0.05)
                injectAllDinos()
            end
        end))
    end
end
CFG.Connections = CFG.Connections or {}
hookDataReplicator()

