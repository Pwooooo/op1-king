    "Pachyrhinosaurus", "Parasaurolophus", "Platecarpus", "Prionosuchus", "Protathlitis",
    "Protoceratops", "Pteranodon", "Purussaurus", "Saltasaurus", "Shantungosaurus",
    "Simosuchus", "Spinofaarus", "Spinolestes", "Spinosaurus", "Stegoceras",
    "Stegosaurus", "Suchomimus", "Tarchia", "Therizinosaurus", "Thoracosaurus",
    "Trilobite", "Tropeognathus", "Tupandactylus", "Tyrannosaurus", "Wendigo",
    "Yunnanosaurus",
}

local DINO_TEMPLATE = { Oxygen = 10, Health = 125, Thirst = 100, Energy = 175, Growth = 0, Hunger = 100 }

local function injectAllDinos()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(Saved.Value)
    end)
    if not ok or type(data) ~= "table" then return end
    data.Dinos = data.Dinos or {}
    for _, name in ipairs(DINO_NAMES) do
        if not data.Dinos[name] then
            data.Dinos[name] = DINO_TEMPLATE
        end
    end
    Saved.Value = HttpService:JSONEncode(data)
end

local function hookDataReplicator()
    local SendData = ReplicatedStorage.Events.UI:FindFirstChild("SendDataToClient")
    if SendData then
        table.insert(CFG.Connections, SendData.OnClientEvent:Connect(function()
            if CFG.UnlockAllActive then
                task.wait(0.05)
                injectAllDinos()
            end
        end))
    end
end
hookDataReplicator()

--[[ UI ]]
if firstLoad then
    local Window = Library:CreateWindow({
        Title = "dino sauwr",
        Footer = "(BOSS FIGHT) Pixelated Past",
        Icon = 95816097006870,
        NotifySide = "Right",
        ShowCustomCursor = true,
    })

    local CombatTab = Window:AddTab("Combat", "sword")
    local VisualTab = Window:AddTab("Visuals", "eye")
    local WorldTab = Window:AddTab("World", "globe")
    local MiscTab = Window:AddTab("Misc", "hammer")

    local DinoBox = MiscTab:AddLeftGroupbox("Dinos", "dinosaur")
    DinoBox:AddToggle("UnlockAll", {
        Text = "Dinosaur Unlock All",
        Default = false,
        Tooltip = "Injects every dino into your client data so the menu shows all 81 as owned. Server-side spawn validation may still apply.",
        Callback = function(value)
            CFG.UnlockAllActive = value
            if value then
                injectAllDinos()
            end
        end,
    })
    DinoBox:AddButton("Refresh Menu", function()
        injectAllDinos()
        Library:Notify("Injected " .. #DINO_NAMES .. " dinos")
    end)

    local UISettings = Window:AddTab("UI Settings", "settings")

    SaveManager:SetLibrary(Library)
    ThemeManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
    ThemeManager:SetFolder("dino_sauwr")
    SaveManager:SetFolder("dino_sauwr/Pixelated Past")
    SaveManager:BuildConfigSection(UISettings)
    ThemeManager:ApplyToTab(UISettings)

    SaveManager:LoadAutoloadConfig()
end

CFG.OnUnload = function()
    CFG.Alive = false
    for _, conn in ipairs(CFG.Connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    CFG.Connections = {}
end
CFG.Connections = CFG.Connections or {}

task.spawn(function()
    while CFG.Alive do
        task.wait()
    end
end)
