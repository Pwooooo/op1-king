    "DodoRex", "Dreadnoughtus", "Dunkleosteus", "Eotriceratops", "Errzinyle",
    "Hatzegopteryx", "Human", "Ichthyovenator", "Iguanodon", "Irritator",
    "Jaekelopterus", "Jeholopterus", "Kaprosuchus", "Kentrosaurus", "Krab",
    "Majungasaurus", "Mastodonsaurus", "Megabite", "Meganeura", "Miragaia",
