-- extended_hitbox.lua - Creatures of Sonaria | Forward Hitbox Expander from Head (Obsidian UI)

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggles

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

getgenv().CoSHitbox = getgenv().CoSHitbox or {}
local CFG = getgenv().CoSHitbox

if CFG.Loaded then
    CFG.Unloading = true
    task.wait(0.05)
    if CFG.OnUnload then pcall(CFG.OnUnload) end
end

local firstLoad = not CFG.Loaded
CFG.Loaded = true
CFG.Alive = false
task.wait(0.1)
CFG.Alive = true

local extendHitboxEnabled = false
local hitboxSize = 200

local hitboxExtender = nil

local function createHitboxExtender()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    if hitboxExtender then
        hitboxExtender:Destroy()
        hitboxExtender = nil
    end

    -- Create forward hitbox extender part starting at head
    hitboxExtender = Instance.new("Part")
    hitboxExtender.Name = "HitboxExtender"
    hitboxExtender.Anchored = false
    hitboxExtender.CanCollide = true
    hitboxExtender.CanTouch = true
    hitboxExtender.CanQuery = true
    hitboxExtender.Massless = true
    hitboxExtender.Transparency = 0.7
    hitboxExtender.Color = Color3.fromRGB(255, 0, 0)
    hitboxExtender.Material = Enum.Material.ForceField
    -- Thin on X/Y, long on Z (forward from head)
    hitboxExtender.Size = Vector3.new(4, 4, hitboxSize)
    hitboxExtender.Parent = char

    -- Weld to head, pointing forward
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = hitboxExtender
    weld.Parent = hitboxExtender

    -- Position it forward from head: offset by half extender length + half head depth
    local headDepth = head.Size.Z
    local extenderDepth = hitboxSize
    local offset = (headDepth / 2) + (extenderDepth / 2)
    hitboxExtender.CFrame = head.CFrame * CFrame.new(0, 0, -offset)
end

local function removeHitboxExtender()
    if hitboxExtender then
        hitboxExtender:Destroy()
        hitboxExtender = nil
    end
end

task.spawn(function()
    while CFG.Alive do
        RunService.Heartbeat:Wait()

        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")

        if extendHitboxEnabled and head then
            if not hitboxExtender or not hitboxExtender.Parent then
                createHitboxExtender()
            else
                -- Update size if changed
                hitboxExtender.Size = Vector3.new(4, 4, hitboxSize)
                -- Re-position forward from head
                local headDepth = head.Size.Z
                local extenderDepth = hitboxSize
                local offset = (headDepth / 2) + (extenderDepth / 2)
                hitboxExtender.CFrame = head.CFrame * CFrame.new(0, 0, -offset)
            end
        else
            removeHitboxExtender()
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    hitboxExtender = nil
end)

CFG.OnUnload = function()
    CFG.Alive = false
    removeHitboxExtender()
end

if firstLoad then
    local Window = Library:CreateWindow({
        Title = "Creatures of Sonaria",
        Footer = "Forward Hitbox Expander from Head",
        Icon = 95816097006870,
        NotifySide = "Right",
        ShowCustomCursor = true,
    })

    local MainTab = Window:AddTab("Main", "sword")

    local HitboxBox = MainTab:AddLeftGroupbox("Hitbox", "crosshair")
    HitboxBox:AddToggle("ExtendHitbox", {
        Text = "Extend Forward Hitbox (from Head)",
        Default = false,
        Tooltip = "Creates a forward-only hitbox extension starting at your creature's head",
        Callback = function(value)
            extendHitboxEnabled = value
        end,
    })
    HitboxBox:AddSlider("HitboxSize", {
        Text = "Forward Length (studs)",
        Default = 200,
        Min = 5,
        Max = 500,
        Rounding = 0,
        Compact = false,
        Callback = function(value)
            hitboxSize = value
        end,
    })

    local UISettings = Window:AddTab("UI Settings", "settings")

    SaveManager:SetLibrary(Library)
    ThemeManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
    ThemeManager:SetFolder("cos_hitbox")
    SaveManager:SetFolder("cos_hitbox/Creatures of Sonaria")
    SaveManager:BuildConfigSection(UISettings)
    ThemeManager:ApplyToTab(UISettings)

    SaveManager:LoadAutoloadConfig()
end