local isCollecting = false

local BROKEN_TEXTS = {"COLLECTING", "ERROR", "BROKEN", "WHY", "STOP"}
local STATUS_MSGS = {
    "COLLECTING EGGS... (NOT REALLY)",
    "SEARCHING FOR EGGS... (FOUND NONE)",
    "AUTO COLLECTING... (ERROR 404)",
    "EGG DETECTED... (JUST KIDDING)",
    "CONNECTING TO SERVER... (TIMEOUT)",
    "COLLECTING... (BUT NOT REALLY)",
    "ALMOST DONE... (NEVER)",
    "ERROR: EGG NOT FOUND",
    "RETRYING... (FAILED AGAIN)",
    "SUCCESS! (LIAR)"
}

local function autoCollect()
    if isCollecting then
        StatusLabel.Text = "STATUS: ALREADY NOT WORKING"
        return
    end
    isCollecting = true
    collectCount = 0
    StatusLabel.Text = "STATUS: STARTING BROKEN COLLECTION..."
    Button.Text = "COLLECTING... (BROKEN)"
    Button.BackgroundColor3 = Color3.new(0.6, 0.4, 0.2)
    Button.Active = false
    
    local progress = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not isCollecting then
            conn:Disconnect()
            return
        end
        
        local change = math.random(-5, 8)
        progress = math.clamp(progress + change, 0, 100)
        ProgressFill.Size = UDim2.new(progress / 100, 0, 1, 0)
        
        local msgIndex = math.random(1, #STATUS_MSGS)
        StatusLabel.Text = STATUS_MSGS[msgIndex]
        
        if math.random() < 0.1 then
            ProgressFill.BackgroundColor3 = Color3.new(math.random(), math.random(), math.random())
        end
        
        if math.random() < 0.05 then
            local textIndex = math.random(1, #BROKEN_TEXTS)
            Button.Text = BROKEN_TEXTS[textIndex]
        end
        
        if math.random() < 0.02 then
            progress = 0
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
            StatusLabel.Text = "STATUS: PROGRESS RESET (ON PURPOSE)"
        end
        
        if progress >= 100 then
            isCollecting = false
            conn:Disconnect()
            Button.Text = "DONE! (NOT REALLY)"
            Button.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
            Button.Active = true
            StatusLabel.Text = "STATUS: FINISHED (BUT NOTHING HAPPENED)"
            ProgressFill.BackgroundColor3 = Color3.new(1, 0, 0)
            
            StarterGui:SetCore("SendNotification", {
                Title = "Auto Collect Complete",
                Text = "Collected 0 eggs. Good job!",
                Duration = 3
            })
            
            task.wait(3)
            progress = 0
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
            ProgressFill.BackgroundColor3 = Color3.new(0, 1, 0)
            Button.Text = "AUTO COLLECT EGGS"
            Button.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
            StatusLabel.Text = "STATUS: READY TO NOT WORK"
        end
    end)
end

