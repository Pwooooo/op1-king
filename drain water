task.spawn(function()
    while CFG.Alive do
        if CFG.AutoStage then
            pcall(function()
                local activeStage = getCurrentStage()
                local _, _, _, completed = getStageProgress(activeStage)
                if completed then
                    CFG.SlowStage = false
                    CFG.StageStartTime = nil
                    local nextStage = getNextUncompletedStage()
                    if nextStage and nextStage ~= activeStage then
                        tpToStage(nextStage)
                        task.wait(1)
                        CFG.StageStartTime = tick()
                    end
                else
                    local _, hrp, _ = getCharacter()
                    local surfPos = getWaterSurfacePos(activeStage)
                    if hrp and surfPos then
                        local dist = (hrp.Position - surfPos).Magnitude
                        if dist > 20 then
                            tpToStage(activeStage)
                            task.wait(1)
                            CFG.StageStartTime = tick()
                        elseif CFG.StageStartTime and (tick() - CFG.StageStartTime) > 30 then
                            CFG.SlowStage = true
                        end
                    end
                end
            end)
        end
        task.wait(CFG.StageInterval or 3)
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoBestFish and CFG.AutoStage and CFG.SlowStage then
            pcall(function()
                local count, cap = getCarryCount()
                if count >= cap then
                    tpToSell()
                    task.wait(1)
                    return
                end

                local allFish = getAllFishSorted()
                for _, fishData in ipairs(allFish) do
                    if fishData.model and fishData.model.Parent then
                        local collected = collectFish(fishData)
                        if collected then
                            task.wait(0.5)
                            local newCount = getCarryCount()
                            if newCount >= cap then
                                tpToSell()
                                task.wait(1)
                                break
                            end
                        end
                    end
                end
            end)
        end
        task.wait(CFG.FishInterval or 3)
    end
end)

