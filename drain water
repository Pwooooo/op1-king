local function placeBestFish()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    local ok, btn = pcall(function()
        return PlayerGui.Main.FishTrainingPopup.FIsh.best.go
    end)
    if ok and btn and btn:IsA("TextButton") then
        local clicked = pcall(function()
            for _, v in pairs(getconnections(btn.Activated)) do
                v:Fire()
            end
        end)
        if not clicked then
            pcall(function()
                local uid = btn.Parent:GetAttribute("FishUid")
                if uid then
                    PlaceFishUI:InvokeServer(tostring(uid))
                end
            end)
        end
        task.wait(0.5)
        return true
    end
    return false
end

local function buyUpgrade(upgradeName)
    local ok, data = pcall(function() return GetUpgradeData:InvokeServer() end)
    if not ok or not data then return false end
    local info = data[upgradeName]
    if not info or info.isMax then return false end
    local price = UpgradeHelper.GetCashPrice(upgradeName, info.level)
    local cash = tonumber(CashValue.Value) or 0
    if price and cash >= price then
        pcall(function()
            BuyCashUpgrade:FireServer(upgradeName)
        end)
        return true
    end
    return false
end

local function getBestAffordableEgg()
    local cash = tonumber(CashValue.Value) or 0
    local bestEgg = nil
    local bestPrice = 0
    local allEggs = EggHelper.GetAllEggConfig()
    for k, v in pairs(allEggs) do
        if type(v) == "table" and v.costType == "Cash" and v.cashPrice then
            local price = Handler.Num.UnAbb(v.cashPrice) or 0
            if price > 0 and cash >= price and price > bestPrice then
                bestPrice = price
                bestEgg = tonumber(k)
            end
        end
    end
    return bestEgg
end

