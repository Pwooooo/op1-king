local function formatNum(n)
    return Handler.Num.Abb(tonumber(n) or 0)
end

local function doClick()
    CFG.ClickId = CFG.ClickId + 1
    ClickRemote:FireServer(CFG.ClickId)
end

local function doRebirth()
    TryRebirthRemote:FireServer()
end

local function doReturnHome()
    ReturnHomeRemote:FireServer()
end

local function doGoShow()
    GoShowRemote:FireServer()
end

local function getBestStage()
    local water = tonumber(WaterValue.Value) or 0
    local best = 1
    for _, id in ipairs(StageHelper.GetStageIds()) do
        if water >= StageHelper.GetWaterRequired(id) then
            best = id
        end
    end
    return best
end

local function getBestAffordableEgg()
    local cash = tonumber(CashValue.Value) or 0
    local bestEgg = nil
    local bestPrice = 0
    local allEggs = EggHelper.GetAllEggConfig()
    for k, v in pairs(allEggs) do
        if type(v) == "table" and v.costType == "Cash" and v.cashPrice then
            local price = Handler.Num.UnAbb(v.cashPrice) or 0
            if price > 0 and cash >= price and price > bestPrice then
                bestPrice = price
                bestEgg = tonumber(k)
            end
        end
    end
    return bestEgg
end

local function doOpenEgg(eggId)
    local success, result = pcall(function()
        return OpenEggRemote:InvokeServer(eggId)
    end)
    return success and result
end

