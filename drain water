local function getCharacter()
    local char = LocalPlayer.Character
    if char then
        return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
    end
    return nil, nil, nil
end

local function getStageState(stageId)
    local success, states = pcall(function()
        return GetStageState:InvokeServer(stageId)
    end)
    if success and states then
        for _, s in ipairs(states) do
            if s.stageId == stageId then
                return s
            end
        end
        if states[1] then
            return states[1]
        end
    end
    return nil
end

local function getNextUncompletedStage()
    local stages = StageHelper.GetStageIds()
    local states = getStageState(stages[1])
    if states then
        local stateList = {}
        if type(states) == "table" then
            if states.stageId then
                stateList = {states}
            else
                for _, s in ipairs(states) do
                    if type(s) == "table" and s.stageId then
                        stateList[s.stageId] = s
                    end
                end
            end
        end
        for _, id in ipairs(stages) do
            local s = stateList[id]
            if s and not s.completed then
                return id
            end
        end
    end
    return stages[1]
end

local function getWaterSurfacePos(stageId)
    local folder = VerifyScene:FindFirstChild("关卡" .. stageId)
    if folder then
        local surface = folder:FindFirstChild("水面")
        if surface then
            return surface.Position, surface.Size
        end
    end
    return nil, nil
end

local function tpToStage(stageId)
    local _, hrp, _ = getCharacter()
    if not hrp then return end
    local pos, size = getWaterSurfacePos(stageId)
    if pos then
        local tpPos = pos + Vector3.new(0, 5, 0)
        hrp.CFrame = CFrame.new(tpPos)
    end
end

local function getStageProgress(stageId)
    local state = getStageState(stageId)
    if state then
        local required = state.required or 1
        local remaining = state.remaining or 0
        local fraction = state.fraction or (remaining / required)
        local drained = required - remaining
        return drained, required, fraction, state.completed or false
    end
    return 0, 1, 1, false
end

local function getBestFishInStage(stageId)
    local bestFish = nil
    local bestRarity = 0
    for _, fish in ipairs(WorldFish:GetChildren()) do
        local name = fish.Name
        local fishIdStr, slotStr = name:match("Fish_(%d+)_(%d+)")
        if fishIdStr then
            local fishId = tonumber(fishIdStr)
            local slot = tonumber(slotStr)
            local fishPos = nil
            if fish:IsA("Model") and fish.PrimaryPart then
                fishPos = fish.PrimaryPart.Position
            end
            if fishPos then
                local surfPos = getWaterSurfacePos(stageId)
                if surfPos and (fishPos - surfPos).Magnitude < 200 then
                    local cfg = FishHelper and FishHelper.GetFishConfig(fishId) or nil
                    local rarity = 0
                    local fishName = "Fish"
                    if cfg then
                        rarity = RARITY_ORDER[cfg.rarity or "Common"] or 0
                        fishName = cfg.name or "Fish"
                    end
                    if rarity > bestRarity or (rarity == bestRarity and not bestFish) then
                        bestRarity = rarity
                        bestFish = {
                            model = fish,
                            fishId = fishId,
                            slot = slot,
                            name = fishName,
                            rarity = cfg and cfg.rarity or "Common",
                            pos = fishPos,
                        }
                    end
                end
            end
        end
    end
    return bestFish
end

local function tpToFish(fishData)
    local _, hrp, _ = getCharacter()
    if not hrp or not fishData or not fishData.pos then return end
    hrp.CFrame = CFrame.new(fishData.pos + Vector3.new(0, 3, 0))
end

local function collectBestFish(stageId)
    local fish = getBestFishInStage(stageId)
    if fish then
        tpToFish(fish)
        task.wait(0.3)
        local success, err = pcall(function()
            DisplayFishRemote:FireServer(fish.model)
        end)
        return fish
    end
    return nil
end

local function getBestAffordableEgg()
    local cash = tonumber(CashValue.Value) or 0
    local bestEgg = nil
    local bestPrice = 0
    local allEggs = EggHelper.GetAllEggConfig()
    for k, v in pairs(allEggs) do
        if type(v) == "table" and v.costType == "Cash" and v.cashPrice then
            local price = Handler.Num.UnAbb(v.cashPrice) or 0
            if price > 0 and cash >= price and price > bestPrice then
                bestPrice = price
                bestEgg = tonumber(k)
            end
        end
    end
    return bestEgg
end

local function doOpenEgg(eggId)
    local success, result = pcall(function()
        return OpenEggRemote:InvokeServer(eggId)
    end)
    return success and result
end

