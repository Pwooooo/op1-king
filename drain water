local function getCharacter()
    local char = LocalPlayer.Character
    if char then
        return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
    end
    return nil, nil, nil
end

local function getAllStageStates()
    local success, states = pcall(function()
        return GetStageState:InvokeServer(1)
    end)
    if success and states and type(states) == "table" then
        return states
    end
    return {}
end

local function getStageStateById(stageId)
    local states = getAllStageStates()
    for _, s in ipairs(states) do
        if s.stageId == stageId then
            return s
        end
    end
    return nil
end

local function getCurrentStage()
    local states = getAllStageStates()
    for _, s in ipairs(states) do
        if not s.completed then
            return s.stageId
        end
    end
    return StageHelper.GetStageIds()[1] or 1
end

local function getNextUncompletedStage()
    local stages = StageHelper.GetStageIds()
    local states = getAllStageStates()
    local stateMap = {}
    for _, s in ipairs(states) do
        stateMap[s.stageId] = s
    end
    for _, id in ipairs(stages) do
        local s = stateMap[id]
        if s and not s.completed then
            return id
        end
    end
    return stages[1]
end

local function getWaterSurfacePos(stageId)
    local folder = VerifyScene:FindFirstChild("关卡" .. stageId)
    if folder then
        local surface = folder:FindFirstChild("水面")
        if surface then
            return surface.Position, surface.Size
        end
    end
    return nil, nil
end

local function tpToStage(stageId)
    local _, hrp, _ = getCharacter()
    if not hrp then return end
    local pos, size = getWaterSurfacePos(stageId)
    if pos then
        local tpPos = pos + Vector3.new(0, 5, 0)
        hrp.CFrame = CFrame.new(tpPos)
    end
end

local function getStageProgress(stageId)
    local state = getStageStateById(stageId)
    if state then
        local required = state.required or 1
        local remaining = state.remaining or 0
        local drained = required - remaining
        return drained, required, state.fraction or 0, state.completed or false
    end
    return 0, 1, 1, false
end

local function getAllFishSorted()
    local states = getAllStageStates()
    local completedStages = {}
    local stageY = {}
    for _, s in ipairs(states) do
        if s.completed then
            completedStages[s.stageId] = true
        end
    end
    for i = 1, 18 do
        local surfPos = getWaterSurfacePos(i)
        if surfPos then
            stageY[i] = surfPos.Y
        end
    end

    local fishList = {}
    for _, fish in ipairs(WorldFish:GetChildren()) do
        local fishIdStr, slotStr = fish.Name:match("Fish_(%d+)_(%d+)")
        if fishIdStr then
            local fishId = tonumber(fishIdStr)
            local pos = nil
            if fish:IsA("Model") and fish.PrimaryPart then
                pos = fish.PrimaryPart.Position
            else
                for _, desc in ipairs(fish:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        pos = desc.Position
                        break
                    end
                end
            end
            if pos then
                local bestStage = nil
                local bestDist = math.huge
                for sid, y in pairs(stageY) do
                    local dist = math.abs(pos.Y - y)
                    if dist < bestDist then
                        bestDist = dist
                        bestStage = sid
                    end
                end
                if bestStage and completedStages[bestStage] then
                    local cfg = FishHelper.GetFishConfig(fishId)
                    if cfg then
                        local price = tonumber(Handler.Num.UnAbb(cfg.basePrice)) or 0
                        table.insert(fishList, {
                            model = fish,
                            fishId = fishId,
                            name = cfg.name or "Fish",
                            price = price,
                            pos = pos,
                        })
                    end
                end
            end
        end
    end
    table.sort(fishList, function(a, b) return a.price > b.price end)
    return fishList
end

local function getCarryCount()
