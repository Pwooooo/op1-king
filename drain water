end

local function collectFish(fishData)
    local _, hrp, _ = getCharacter()
    if not hrp or not fishData or not fishData.pos then return false end
    hrp.CFrame = CFrame.new(fishData.pos + Vector3.new(0, 3, 0))
    task.wait(0.3)

    local prompt = nil
    for _, desc in ipairs(fishData.model:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            prompt = desc
            break
        end
    end

    if prompt then
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.6)
            prompt:InputHoldEnd()
        end)
        return true
    end
    return false
end

