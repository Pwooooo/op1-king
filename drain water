task.spawn(function()
    while CFG.Alive do
        task.wait(0.5)
        WaterLabel:SetValue("Water: " .. formatNum(WaterValue.Value))
        CashLabel:SetValue("Cash: $" .. formatNum(CashValue.Value))
        RebirthLabel:SetValue("Rebirths: " .. formatNum(RebirthValue.Value))
        BackpackLabel:SetValue("Backpack: " .. formatNum(BackpackAmount.Value) .. "/" .. formatNum(BackpackCapacity.Value))
        ClickLabel:SetValue("Click Power: " .. formatNum(ClickAmountValue.Value))

        local bestStage = getBestStage()
        BestStageLabel:SetValue("Best Stage: " .. bestStage)

        local eggId = getBestAffordableEgg()
        if eggId then
            local name = EggHelper.GetEggName(eggId)
            BestEggLabel:SetValue("Best Egg: " .. name .. " (id:" .. eggId .. ")")
        else
            BestEggLabel:SetValue("Best Egg: None affordable")
        end

        StageStatus:SetValue("Current Stage: " .. (LocalPlayer:GetAttribute("ActiveWaterStageId") or "?"))
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoClick then
            doClick()
            task.wait(CFG.ClickDelay)
        else
            task.wait(0.1)
        end
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoRebirth then
            if tonumber(WaterValue.Value) >= CFG.RebirthThreshold then
                doRebirth()
                task.wait(1)
            end
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoReturnHome then
            task.wait(CFG.ReturnHomeInterval)
            if CFG.AutoReturnHome then
                doReturnHome()
            end
        else
            task.wait(0.5)
        end
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoBestZone then
            local bestStage = getBestStage()
            local activeStage = LocalPlayer:GetAttribute("ActiveWaterStageId") or 0
            if bestStage ~= activeStage then
                local success, state = pcall(function()
                    return GetStageState:InvokeServer(bestStage)
                end)
                if success and state and not state.completed then
                    doGoShow()
                    task.wait(2)
                end
            end
        end
        task.wait(CFG.ZoneInterval or 5)
    end
end)

task.spawn(function()
    while CFG.Alive do
        if CFG.AutoBestPet then
            local eggId = getBestAffordableEgg()
            if eggId then
                local canOpen = pcall(function()
                    return CanOpenEggRemote:InvokeServer(eggId)
                end)
                if canOpen then
                    doOpenEgg(eggId)
                end
            end
        end
        task.wait(CFG.BestPetInterval)
    end
end)

