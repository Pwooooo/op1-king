local function updateInfo()
    WaterLabel:SetValue("Water: " .. formatNum(WaterValue.Value))
    CashLabel:SetValue("Cash: $" .. formatNum(CashValue.Value))
    RebirthLabel:SetValue("Rebirths: " .. formatNum(RebirthValue.Value))
    LevelLabel:SetValue("Level: " .. formatNum(LevelValue.Value) .. " / Need: " .. formatNum(RebirthNeedValue.Value))
    BackpackLabel:SetValue("Backpack: " .. formatNum(BackpackAmount.Value) .. "/" .. formatNum(BackpackCapacity.Value))
    ClickLabel:SetValue("Click Power: " .. formatNum(ClickAmountValue.Value))

    local activeStage = getCurrentStage()
    CurrentStageLabel:SetValue("Current Stage: " .. activeStage)

    local drained, required, fraction, completed = getStageProgress(activeStage)
    StageProgressLabel:SetValue("Progress: " .. formatNum(drained) .. "/" .. formatNum(required) .. (completed and " (DONE)" or ""))

    local bestFish = getAllFishSorted()[1]
    if bestFish then
        BestFishLabel:SetValue("Best Fish: " .. bestFish.name .. " ($" .. formatNum(bestFish.price) .. ")")
    else
        BestFishLabel:SetValue("Best Fish: None in completed stages")
    end

    local eggId = getBestAffordableEgg()
    if eggId then
        local name = EggHelper.GetEggName(eggId)
        BestEggLabel:SetValue("Best Egg: " .. name)
    else
        BestEggLabel:SetValue("Best Egg: None affordable")
    end
end

